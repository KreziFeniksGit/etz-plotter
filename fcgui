#!/bin/sh
# Run a script inside the FreeCAD GUI (needed for coloured STEP/FCStd export). Linux: headless via offscreen Qt.
for F in "$FREECAD_DIR" "$HOME/tools/freecad/squashfs-root/usr" /home/claude/tools/freecad/squashfs-root/usr /usr; do
  [ -n "$F" ] || continue
  if [ -x "$F/bin/freecad" ]; then QT_QPA_PLATFORM=${QT_QPA_PLATFORM:-offscreen} exec "$F/bin/freecad" "$@"; fi
done
echo "FreeCAD GUI not found: set FREECAD_DIR" >&2; exit 1
